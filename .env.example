# ─── Objection AI · environment ───────────────────────────────────────────
# Copy to `.env` (repo root). Every value has a safe default; the app runs in
# MOCK mode with zero API keys.

# ── Audio provider ──
# mock       → local procedurally generated voices, never touches the network (default)
# fish-free  → Fish Audio free-tier model, only if verified free for your account
# drama3     → Fish Audio Drama 3 (PAID). Also requires ENABLE_PAID_TTS=true.
AUDIO_PROVIDER=mock
FISH_AUDIO_API_KEY=
ENABLE_PAID_TTS=false
# Application-level guard rails (not provider-enforced limits)
DRAMA3_MAX_PROJECTED_SPEND_USD=2
DRAMA3_MAX_CHARACTERS_PER_CASE=6000
# Credit kept untouchable for the live demo
DRAMA3_DEMO_RESERVE_USD=3
# Experimental: one multi-speaker request per scene (more natural flow), split into lines by silence
DRAMA3_SCENE_STRATEGY=false

# ── LLM provider ──
# mock      → deterministic local comedy engine (no network)
# ollama    → local Ollama server
# anthropic → Claude API
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Infrastructure ──
DATABASE_URL=postgresql+asyncpg://objection:objection@localhost:5434/objection
REDIS_URL=redis://localhost:6381/0
STORAGE_DIR=./storage
# Run the background job worker inside the API process (handy for local dev)
RUN_WORKER_IN_PROCESS=true
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
